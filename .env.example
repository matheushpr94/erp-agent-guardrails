# Provedor do ERP: "mock" (padrao, roda tudo offline) ou "contaazul" (adaptador real, ver docs/adaptador-contaazul.md)
ERP_PROVIDER=mock

# Mock local (npm run mock)
ERP_API_BASE=http://127.0.0.1:8787
ERP_AUTH_BASE=http://127.0.0.1:8787
ERP_CLIENT_ID=mock-client
ERP_CLIENT_SECRET=mock-secret

# Onde mora o par de tokens (refresh rotativo). Nunca versionar.
ERP_TOKEN_FILE=.tokens.mock.json

# Rate limit do cliente (duas janelas): por segundo e por minuto
ERP_RPS=8
ERP_RPM=550

# Kill-switch mestre da escrita + allowlist por tool. As DUAS precisam liberar.
ERP_ESCRITA=desabilitada
ERP_ESCRITA_TOOLS=

# Papel de quem fala (dono | funcionario | dev). Quem preenche e o GATEWAY, nunca o modelo.
CANAL_PAPEL=

# Agente opcional (npm run agente): chave da API da Anthropic. Sem ela, nada de LLM roda.
ANTHROPIC_API_KEY=
AGENTE_MODELO=claude-sonnet-4-5

# Gateway Telegram de exemplo: desligado por padrao.
TELEGRAM_HABILITADO=0
TELEGRAM_BOT_TOKEN=
